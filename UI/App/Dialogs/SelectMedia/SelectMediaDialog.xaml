<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GT4.UI.Dialogs.SelectMediaDialog"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:GT4.UI.Components"
    xmlns:items="clr-namespace:GT4.UI.Items"
    xmlns:resources="clr-namespace:GT4.UI.Resources;assembly=GT4.UI.Resources"
    x:Name="Root">

  <components:PageLayout
      Title="{x:Static resources:UIStrings.TitleSelectMediaDialog}"
      BackCommand="{Binding DialogCommand, Source={x:Reference Root}}"
      HasBackButton="True"
      Loading="{Binding Loading, Source={x:Reference Root}}">

    <components:PageLayout.Header>
      <Grid
          ColumnDefinitions="Auto, *"
          ColumnSpacing="{StaticResource PageContentSpacing}"
          RowDefinitions="Auto"
          RowSpacing="{StaticResource PageContentSpacing}">

        <Label
            Grid.Column="0"
            Style="{StaticResource FieldName}"
            Text="{x:Static resources:UIStrings.FieldSearchText}" />

        <Entry
            Grid.Column="1"
            HorizontalOptions="Fill"
            Style="{StaticResource FieldValue}"
            Text="{Binding OwnerFilter, Source={x:Reference Root}}" />
      </Grid>
    </components:PageLayout.Header>

    <components:PageLayout.Body>
      <CollectionView
          HorizontalOptions="Fill"
          ItemsSource="{Binding Items, Source={x:Reference Root}}"
          SelectedItem="{Binding SelectedItem, Source={x:Reference Root}}"
          SelectionMode="Single">

        <CollectionView.ItemsLayout>
          <LinearItemsLayout Orientation="Vertical" />
        </CollectionView.ItemsLayout>

        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="items:GalleryDataItem">
            <Grid
                Padding="{StaticResource CollectionItemsVerticalPadding}"
                ColumnDefinitions="Auto, *"
                ColumnSpacing="10"
                RowDefinitions="Auto, Auto"
                Style="{StaticResource HoverSubItem}">

              <Image
                  Grid.Row="0"
                  Grid.RowSpan="2"
                  Grid.Column="0"
                  Source="{Binding Icon}"
                  Style="{StaticResource PhotoThumbStyle}" />

              <Label
                  Grid.Row="0"
                  Grid.Column="1"
                  LineBreakMode="WordWrap"
                  Style="{StaticResource CardTitle}"
                  Text="{Binding Title}"
                  VerticalOptions="End" />

              <!--  Whose media this is: the only way to tell two identically captioned photos apart.  -->
              <Label
                  Grid.Row="1"
                  Grid.Column="1"
                  IsVisible="{Binding HasDistinctOwners}"
                  LineBreakMode="WordWrap"
                  Style="{StaticResource CardContent}"
                  Text="{Binding Owners}"
                  VerticalOptions="Start" />
            </Grid>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>
    </components:PageLayout.Body>

    <components:PageLayout.Footer>
      <Button
          Command="{Binding DialogCommand, Source={x:Reference Root}}"
          CommandParameter="SelectMediaCommand"
          FontSize="{DynamicResource ActionButtonTextSize}"
          Text="{Binding DialogButtonName, Source={x:Reference Root}}" />
    </components:PageLayout.Footer>
  </components:PageLayout>
</ContentPage>
