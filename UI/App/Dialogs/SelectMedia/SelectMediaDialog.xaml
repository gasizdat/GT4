<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GT4.UI.Dialogs.SelectMediaDialog"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:GT4.UI.Components"
    xmlns:dialogs="clr-namespace:GT4.UI.Dialogs"
    xmlns:resources="clr-namespace:GT4.UI.Resources;assembly=GT4.UI.Resources"
    x:Name="Root">

  <components:PageLayout>
    <components:PageLayout.Header>
      <Label
          HorizontalTextAlignment="Center"
          Style="{StaticResource PageTitle}"
          Text="{x:Static resources:UIStrings.TitleSelectMediaDialog}" />
    </components:PageLayout.Header>

    <components:PageLayout.Body>
      <CollectionView
          HorizontalOptions="Center"
          ItemsSource="{Binding Items, Source={x:Reference Root}}"
          SelectedItem="{Binding SelectedItem, Source={x:Reference Root}}"
          SelectionMode="Single">

        <CollectionView.ItemsLayout>
          <LinearItemsLayout Orientation="Vertical" />
        </CollectionView.ItemsLayout>

        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="dialogs:MediaLinkItem">
            <Grid
                Padding="{StaticResource CollectionItemsVerticalPadding}"
                Style="{StaticResource HoverSubItem}">
              <Label
                  Style="{StaticResource FieldValue}"
                  Text="{Binding DisplayName}" />
            </Grid>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>
    </components:PageLayout.Body>

    <components:PageLayout.Footer>
      <Button
          Command="{Binding DialogCommand, Source={x:Reference Root}}"
          CommandParameter="SelectMediaCommand"
          FontSize="{DynamicResource ActionButtonTextSize}"
          Text="{Binding DialogButtonName, Source={x:Reference Root}}" />
    </components:PageLayout.Footer>
  </components:PageLayout>
</ContentPage>
