<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GT4.UI.Pages.StatisticsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:GT4.UI.Components"
    xmlns:items="clr-namespace:GT4.UI.Items"
    xmlns:resources="clr-namespace:GT4.UI.Resources;assembly=GT4.UI.Resources"
    x:Name="Root"
    NavigatedTo="OnNavigatedTo">

  <ContentPage.Resources>
    <ResourceDictionary>
      <Style x:Key="GroupTitleCenter" BasedOn="{StaticResource GroupTitle}" TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
      </Style>
      <Style x:Key="FieldNameTop" BasedOn="{StaticResource FieldName}" TargetType="Label">
        <Setter Property="VerticalTextAlignment" Value="Start" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="HorizontalOptions" Value="Fill" />
      </Style>
      <Style x:Key="FieldValueWordWrap" BasedOn="{StaticResource FieldValue}" TargetType="Label">
        <Setter Property="LineBreakMode" Value="WordWrap" />
      </Style>
      <Style x:Key="BirthDecadeName" BasedOn="{StaticResource FieldValue}" TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
      </Style>
      <Style x:Key="BirthDecadeBar" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 2" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
      </Style>
      <Style x:Key="BirthDecadeCount" BasedOn="{StaticResource FieldValue}" TargetType="Label">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </ContentPage.Resources>

  <components:PageLayout
      Title="{x:Static resources:UIStrings.TitleStatisticsPage}"
      HasBackButton="True"
      Loading="{Binding Loading, Source={x:Reference Root}}"
      ShowsProjectName="True">
    <components:PageLayout.Body>
      <ScrollView>
        <Grid
            ColumnDefinitions="3*, 7*"
            ColumnSpacing="{StaticResource PageContentSpacing}"
            RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
            RowSpacing="{StaticResource PageContentSpacing}">

          <Label
              Grid.Row="0"
              Grid.ColumnSpan="2"
              Style="{StaticResource GroupTitleCenter}"
              Text="{x:Static resources:UIStrings.FieldStatOverview}" />
          <Label
              Grid.Row="1"
              Grid.Column="0"
              Style="{StaticResource FieldNameTop}"
              Text="{x:Static resources:UIStrings.FieldStatTotalPersons}" />
          <Label
              Grid.Row="1"
              Grid.Column="1"
              Style="{StaticResource FieldValueWordWrap}"
              Text="{Binding TotalPersonsText, Source={x:Reference Root}}" />
          <Label
              Grid.Row="2"
              Grid.Column="0"
              Style="{StaticResource FieldNameTop}"
              Text="{x:Static resources:UIStrings.FieldStatTotalFamilies}" />
          <Label
              Grid.Row="2"
              Grid.Column="1"
              Style="{StaticResource FieldValueWordWrap}"
              Text="{Binding TotalFamiliesText, Source={x:Reference Root}}" />
          <Label
              Grid.Row="3"
              Grid.Column="0"
              Style="{StaticResource FieldNameTop}"
              Text="{x:Static resources:UIStrings.FieldStatMenCount}" />
          <Label
              Grid.Row="3"
              Grid.Column="1"
              Style="{StaticResource FieldValueWordWrap}"
              Text="{Binding MenCountText, Source={x:Reference Root}}" />
          <Label
              Grid.Row="4"
              Grid.Column="0"
              Style="{StaticResource FieldNameTop}"
              Text="{x:Static resources:UIStrings.FieldStatWomenCount}" />
          <Label
              Grid.Row="4"
              Grid.Column="1"
              Style="{StaticResource FieldValueWordWrap}"
              Text="{Binding WomenCountText, Source={x:Reference Root}}" />
          <Label
              Grid.Row="5"
              Grid.Column="0"
              Style="{StaticResource FieldNameTop}"
              Text="{x:Static resources:UIStrings.FieldStatUnknownSexCount}" />
          <Label
              Grid.Row="5"
              Grid.Column="1"
              Style="{StaticResource FieldValueWordWrap}"
              Text="{Binding UnknownSexCountText, Source={x:Reference Root}}" />
          <Label
              Grid.Row="6"
              Grid.Column="0"
              Style="{StaticResource FieldNameTop}"
              Text="{x:Static resources:UIStrings.FieldStatLivingCount}" />
          <Label
              Grid.Row="6"
              Grid.Column="1"
              Style="{StaticResource FieldValueWordWrap}"
              Text="{Binding LivingCountText, Source={x:Reference Root}}" />

          <Label
              Grid.Row="7"
              Grid.ColumnSpan="2"
              Style="{StaticResource GroupTitleCenter}"
              Text="{x:Static resources:UIStrings.FieldStatAge}" />
          <Label
              Grid.Row="8"
              Grid.Column="0"
              Style="{StaticResource FieldNameTop}"
              Text="{x:Static resources:UIStrings.FieldStatAverageLifespan}" />
          <Label
              Grid.Row="8"
              Grid.Column="1"
              Style="{StaticResource FieldValueWordWrap}"
              Text="{Binding AverageLifespanText, Source={x:Reference Root}}" />
          <Label
              Grid.Row="9"
              Grid.Column="0"
              Style="{StaticResource FieldNameTop}"
              Text="{x:Static resources:UIStrings.FieldStatLifespan95thPercentile}" />
          <Label
              Grid.Row="9"
              Grid.Column="1"
              Style="{StaticResource FieldValueWordWrap}"
              Text="{Binding Lifespan95thPercentileText, Source={x:Reference Root}}" />
          <Label
              Grid.Row="10"
              Grid.Column="0"
              Style="{StaticResource FieldNameTop}"
              Text="{x:Static resources:UIStrings.FieldStatOldestLiving}" />
          <Label
              Grid.Row="10"
              Grid.Column="1"
              Style="{StaticResource FieldValueWordWrap}"
              Text="{Binding OldestLivingText, Source={x:Reference Root}}" />
          <Label
              Grid.Row="11"
              Grid.Column="0"
              Style="{StaticResource FieldNameTop}"
              Text="{x:Static resources:UIStrings.FieldStatLongestLifespan}" />
          <Label
              Grid.Row="11"
              Grid.Column="1"
              Style="{StaticResource FieldValueWordWrap}"
              Text="{Binding LongestLifespanText, Source={x:Reference Root}}" />

          <Label
              Grid.Row="12"
              Grid.ColumnSpan="2"
              Style="{StaticResource GroupTitleCenter}"
              Text="{x:Static resources:UIStrings.FieldStatBirthYears}" />
          <Label
              Grid.Row="13"
              Grid.Column="0"
              Style="{StaticResource FieldNameTop}"
              Text="{x:Static resources:UIStrings.FieldStatBirthYearSpan}" />
          <Label
              Grid.Row="13"
              Grid.Column="1"
              Style="{StaticResource FieldValueWordWrap}"
              Text="{Binding BirthYearSpanText, Source={x:Reference Root}}" />
          <Label
              Grid.Row="14"
              Grid.Column="0"
              Style="{StaticResource FieldNameTop}"
              Text="{x:Static resources:UIStrings.FieldStatMedianBirthYear}" />
          <Label
              Grid.Row="14"
              Grid.Column="1"
              Style="{StaticResource FieldValueWordWrap}"
              Text="{Binding MedianBirthYearText, Source={x:Reference Root}}" />
          <Label
              Grid.Row="15"
              Grid.Column="0"
              Style="{StaticResource FieldNameTop}"
              Text="{x:Static resources:UIStrings.FieldStatBirthsByDecade}" />
          <FlexLayout
              x:Name="BirthsByDecadeChart"
              Grid.Row="15"
              Grid.Column="1"
              Direction="Row"
              BindableLayout.ItemsSource="{Binding BirthsByDecade, Source={x:Reference Root}}">
            <BindableLayout.EmptyViewTemplate>
              <DataTemplate>
                <Label
                    Style="{StaticResource FieldValue}"
                    Text="{x:Static resources:UIStrings.StatValueNone}" />
              </DataTemplate>
            </BindableLayout.EmptyViewTemplate>
            <BindableLayout.ItemTemplate>
              <!--  One label per group, not per bar: a lone decade's cell is too narrow to hold its own
                    label once there are many decades, but a whole group's cell grows with it.  -->
              <DataTemplate x:DataType="items:BirthDecadeGroupItem">
                <Grid
                    FlexLayout.Basis="0"
                    FlexLayout.Grow="1"
                    RowDefinitions="Auto, Auto">
                  <!--  A Grid with bound equal-star ColumnDefinitions, not a nested FlexLayout: a
                        FlexLayout sized by an outer FlexLayout's flex distribution never re-runs its own
                        distribution at arrange, so every bar but the first rendered at zero width.  -->
                  <Grid
                      Grid.Row="0"
                      ColumnDefinitions="{Binding BarColumns}"
                      BindableLayout.ItemsSource="{Binding Bars}">
                    <BindableLayout.ItemTemplate>
                      <DataTemplate x:DataType="items:BirthDecadeItem">
                        <Grid
                            Grid.Column="{Binding Column}"
                            RowDefinitions="Auto, Auto">
                          <Label
                              Grid.Row="0"
                              Style="{StaticResource BirthDecadeCount}"
                              Text="{Binding Count}" />
                          <!--  The fixed height lives on this row alone, never on a row holding text, so
                                FontScale growing the count/decade labels can't squeeze the bar area.  -->
                          <Grid
                              Grid.Row="1"
                              HeightRequest="120"
                              RowDefinitions="{Binding BarRows}">
                            <Border
                                Grid.Row="1"
                                Style="{StaticResource BirthDecadeBar}" />
                          </Grid>
                        </Grid>
                      </DataTemplate>
                    </BindableLayout.ItemTemplate>
                  </Grid>
                  <Label
                      Grid.Row="1"
                      Style="{StaticResource BirthDecadeName}"
                      Text="{Binding Decade}" />
                </Grid>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </FlexLayout>

          <Label
              Grid.Row="16"
              Grid.ColumnSpan="2"
              Style="{StaticResource GroupTitleCenter}"
              Text="{x:Static resources:UIStrings.FieldStatNames}" />
          <Label
              Grid.Row="17"
              Grid.Column="0"
              Style="{StaticResource FieldNameTop}"
              Text="{x:Static resources:UIStrings.FieldStatLargestFamily}" />
          <Label
              Grid.Row="17"
              Grid.Column="1"
              Style="{StaticResource FieldValueWordWrap}"
              Text="{Binding TopLargestFamiliesText, Source={x:Reference Root}}" />
          <Label
              Grid.Row="18"
              Grid.Column="0"
              Style="{StaticResource FieldNameTop}"
              Text="{x:Static resources:UIStrings.FieldStatSingleMemberFamilies}" />
          <Label
              Grid.Row="18"
              Grid.Column="1"
              Style="{StaticResource FieldValueWordWrap}"
              Text="{Binding SingleMemberFamiliesText, Source={x:Reference Root}}" />
          <Label
              Grid.Row="19"
              Grid.Column="0"
              Style="{StaticResource FieldNameTop}"
              Text="{x:Static resources:UIStrings.FieldStatTopMaleFirstNames}" />
          <Label
              Grid.Row="19"
              Grid.Column="1"
              Style="{StaticResource FieldValueWordWrap}"
              Text="{Binding TopMaleFirstNamesText, Source={x:Reference Root}}" />
          <Label
              Grid.Row="20"
              Grid.Column="0"
              Style="{StaticResource FieldNameTop}"
              Text="{x:Static resources:UIStrings.FieldStatTopFemaleFirstNames}" />
          <Label
              Grid.Row="20"
              Grid.Column="1"
              Style="{StaticResource FieldValueWordWrap}"
              Text="{Binding TopFemaleFirstNamesText, Source={x:Reference Root}}" />

          <Label
              Grid.Row="21"
              Grid.ColumnSpan="2"
              Style="{StaticResource GroupTitleCenter}"
              Text="{x:Static resources:UIStrings.FieldStatDataCompleteness}" />
          <Label
              Grid.Row="22"
              Grid.Column="0"
              Style="{StaticResource FieldNameTop}"
              Text="{x:Static resources:UIStrings.FieldStatIncompleteBirthDates}" />
          <Label
              Grid.Row="22"
              Grid.Column="1"
              Style="{StaticResource FieldValueWordWrap}"
              Text="{Binding IncompleteBirthDateCountText, Source={x:Reference Root}}" />
          <Label
              Grid.Row="23"
              Grid.Column="0"
              Style="{StaticResource FieldNameTop}"
              Text="{x:Static resources:UIStrings.FieldStatPhotoCoverage}" />
          <Label
              Grid.Row="23"
              Grid.Column="1"
              Style="{StaticResource FieldValueWordWrap}"
              Text="{Binding PhotoCoverageText, Source={x:Reference Root}}" />
          <Label
              Grid.Row="24"
              Grid.Column="0"
              Style="{StaticResource FieldNameTop}"
              Text="{x:Static resources:UIStrings.FieldStatIsolatedPersons}" />
          <Label
              Grid.Row="24"
              Grid.Column="1"
              Style="{StaticResource FieldValueWordWrap}"
              Text="{Binding IsolatedPersonCountText, Source={x:Reference Root}}" />

          <Label
              Grid.Row="25"
              Grid.ColumnSpan="2"
              Style="{StaticResource GroupTitleCenter}"
              Text="{x:Static resources:UIStrings.FieldStatRelationships}" />
          <Label
              Grid.Row="26"
              Grid.Column="0"
              Style="{StaticResource FieldNameTop}"
              Text="{x:Static resources:UIStrings.FieldStatMarriageCount}" />
          <Label
              Grid.Row="26"
              Grid.Column="1"
              Style="{StaticResource FieldValueWordWrap}"
              Text="{Binding MarriageCountText, Source={x:Reference Root}}" />
          <Label
              Grid.Row="27"
              Grid.Column="0"
              Style="{StaticResource FieldNameTop}"
              Text="{x:Static resources:UIStrings.FieldStatAverageChildren}" />
          <Label
              Grid.Row="27"
              Grid.Column="1"
              Style="{StaticResource FieldValueWordWrap}"
              Text="{Binding AverageChildrenText, Source={x:Reference Root}}" />
          <Label
              Grid.Row="28"
              Grid.Column="0"
              Style="{StaticResource FieldNameTop}"
              Text="{x:Static resources:UIStrings.FieldStatMostChildren}" />
          <Label
              Grid.Row="28"
              Grid.Column="1"
              Style="{StaticResource FieldValueWordWrap}"
              Text="{Binding MostChildrenText, Source={x:Reference Root}}" />

        </Grid>
      </ScrollView>
    </components:PageLayout.Body>
  </components:PageLayout>

</ContentPage>
