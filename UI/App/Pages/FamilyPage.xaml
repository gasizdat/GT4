<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GT4.UI.Pages.FamilyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:GT4.UI.Components"
    xmlns:dto="clr-namespace:GT4.Core.Project.Dto;assembly=GT4.Core.Project"
    xmlns:items="clr-namespace:GT4.UI.Items"
    xmlns:resources="clr-namespace:GT4.UI.Resources;assembly=GT4.UI.Resources"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2021/maui/toolkit"
    x:Name="Root">

  <ContentPage.Resources>
    <ResourceDictionary>

      <Style x:Key="PhotoStyle" TargetType="Image">
        <Setter Property="Aspect" Value="AspectFit" />
        <Setter Property="HeightRequest" Value="{StaticResource PhotoHeight}" />
        <Setter Property="WidthRequest" Value="{StaticResource PhotoWidth}" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Center" />
      </Style>

    </ResourceDictionary>
  </ContentPage.Resources>

  <components:PageLayout
      Title="{Binding FamilyName.Value, Source={x:Reference Root}}"
      Hint="{x:Static resources:UIStrings.HintFamilyPage}">

    <components:PageLayout.MenuItems>
      <items:PageMenuItem
          Command="{Binding PageCommand, Source={x:Reference Root}}"
          CommandParameter="RemoveFamily"
          IsEnabled="{Binding EnableFamilyChanges, Source={x:Reference Root}}"
          Text="{Binding RemoveFamilyToolbarItemName, Source={x:Reference Root}}" />
      <items:PageMenuItem
          Command="{Binding PageCommand, Source={x:Reference Root}}"
          CommandParameter="EditFamily"
          IsEnabled="{Binding EnableFamilyChanges, Source={x:Reference Root}}"
          Text="{Binding EditFamilyToolbarItemName, Source={x:Reference Root}}" />
      <items:PageMenuItem
          Command="{Binding PageCommand, Source={x:Reference Root}}"
          CommandParameter="CreatePerson"
          Text="{x:Static resources:UIStrings.MenuItemNameAddPerson}" />
      <items:PageMenuItem
          Command="{Binding PageCommand, Source={x:Reference Root}}"
          CommandParameter="Refresh"
          Text="{x:Static resources:UIStrings.MenuItemNameRefresh}" />
    </components:PageLayout.MenuItems>

    <components:PageLayout.Header>
      <components:PersonFilterView x:Name="FilterView" />
    </components:PageLayout.Header>

    <components:PageLayout.Body>
      <!--
        The page's own scrolling belongs to this CollectionView, not to a ScrollView around it: a
        ScrollView hands its child unlimited height, so every member would be realized at once,
        which crashes outright past roughly 150 of them. The family media rides along as the
        Header so it still scrolls away with the list instead of competing with it for height.
      -->
      <CollectionView
          x:Name="MembersView"
          ItemsSource="{Binding Persons, Source={x:Reference Root}}"
          SelectionMode="None">

        <CollectionView.Header>
          <VerticalStackLayout Spacing="{StaticResource PageContentSpacing}">

            <Border IsVisible="{Binding ShowPhotos, Source={x:Reference Root}}">
              <components:ImagePresenter
                  ImageStyle="{StaticResource PhotoStyle}"
                  Photos="{Binding Photos, Source={x:Reference Root}}" />
            </Border>

            <Border IsVisible="{Binding ShowAttachments, Source={x:Reference Root}}">
              <VerticalStackLayout>
                <Label
                    Style="{StaticResource GroupTitle}"
                    Text="{x:Static resources:UIStrings.FieldPersonAttachments}" />

                <CollectionView
                    ItemsSource="{Binding Attachments, Source={x:Reference Root}}"
                    SelectionMode="Single">
                  <CollectionView.ItemTemplate>
                    <DataTemplate>
                      <Grid
                          Padding="{StaticResource CollectionItemsVerticalPadding}"
                          Style="{StaticResource HoverSubItem}">
                        <Grid.GestureRecognizers>
                          <TapGestureRecognizer
                              Command="{Binding Path=PageCommand, Source={x:Reference Root}}"
                              CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <VerticalStackLayout>
                          <Label
                              Style="{StaticResource FieldValue}"
                              Text="{Binding DisplayName}" />
                          <Label
                              IsVisible="{Binding ShowFileName}"
                              Opacity="0.6"
                              Style="{StaticResource FieldValue}"
                              Text="{Binding FileName}" />
                        </VerticalStackLayout>
                      </Grid>
                    </DataTemplate>
                  </CollectionView.ItemTemplate>
                </CollectionView>
              </VerticalStackLayout>
            </Border>
          </VerticalStackLayout>
        </CollectionView.Header>

        <!--
          One member per row, not a two-column GridItemsLayout: a grid row takes the height of its
          tallest cell, and a family mixing short names with long ones (or dated with undated)
          crashes WinUI outright on the resulting uneven rows.
        -->
        <CollectionView.ItemsLayout>
          <LinearItemsLayout Orientation="Vertical" />
        </CollectionView.ItemsLayout>

        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="dto:PersonInfo">
            <components:CardView>

              <components:CardView.GestureRecognizers>
                <TapGestureRecognizer
                    Command="{Binding Path=MemberItemTappedCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                    CommandParameter="{Binding .}" />
              </components:CardView.GestureRecognizers>

              <components:PersonInfoView
                  DatesLabelStyle="{StaticResource FieldValue}"
                  NameFormat="{Binding PersonNamesFormat, Source={x:Reference Root}}"
                  NameLabelStyle="{StaticResource FieldName}"
                  Person="{Binding .}" />
            </components:CardView>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>
    </components:PageLayout.Body>
    <components:PageLayout.Footer>
      <Button
          Command="{Binding PageCommand, Source={x:Reference Root}}"
          CommandParameter="CreatePerson"
          FontSize="{DynamicResource ActionButtonTextSize}"
          HorizontalOptions="Fill"
          Text="{x:Static resources:UIStrings.BtnNameCreateFamilyPerson}" />
    </components:PageLayout.Footer>
  </components:PageLayout>
</ContentPage>