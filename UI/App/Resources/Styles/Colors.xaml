<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

  <!--  Note: For Android please see also Platforms\Android\Resources\values\colors.xml  -->

  <!--
    Accent, Birth and Death are painted without an AppThemeBinding (DateCalendarPage indicators), so
    each has to clear 3:1 against both the light and the dark page. That caps how light or dark any
    of the three may go.
  -->
  <Color x:Key="Accent">#8B6F4E</Color>
  <Color x:Key="AccentDark">#D8B37F</Color>
  <Color x:Key="Birth">#BC6A7E</Color>
  <Color x:Key="BirthDark">#E39BAE</Color>
  <Color x:Key="Death">#64707C</Color>
  <Color x:Key="DeathDark">#9AA7B4</Color>
  <Color x:Key="DateCalendarBorder">#CFC9B9</Color>
  <Color x:Key="DateCalendarBorderDark">#3A3833</Color>
  <Color x:Key="DateCalendarMilestoneBg">#F0E0B4</Color>
  <Color x:Key="DateCalendarMilestoneBgDark">#4A3D22</Color>
  <Color x:Key="DateCalendarMilestoneText">#6B4E17</Color>
  <Color x:Key="DateCalendarMilestoneTextDark">#F0D9A6</Color>
  <Color x:Key="DateCalendarBirthWash">#F7ECEE</Color>
  <Color x:Key="DateCalendarBirthWashDark">#3A2C2F</Color>
  <Color x:Key="DateCalendarDeathWash">#ECEEF0</Color>
  <Color x:Key="DateCalendarDeathWashDark">#2C3034</Color>
  <Color x:Key="DateCalendarWeddingWash">#F5EFE4</Color>
  <Color x:Key="DateCalendarWeddingWashDark">#3A3227</Color>
  <Color x:Key="Primary">#1E4437</Color>
  <Color x:Key="PrimaryDark">#7FC0A4</Color>
  <Color x:Key="PrimaryDarkText">#12241D</Color>
  <Color x:Key="Secondary">#D6E4DC</Color>
  <Color x:Key="SecondaryDark">#2E2C28</Color>
  <Color x:Key="SecondaryDarkText">#C6DCD0</Color>
  <Color x:Key="SurfaceSubtle">#EAE7E0</Color>
  <Color x:Key="SurfaceSubtleDark">#353530</Color>
  <Color x:Key="Tertiary">#1D4034</Color>

  <!--
    Interaction roles, authored as palette ink at an alpha rather than as flat surface colours: one
    value then reads correctly over the page, over a frosted-glass card and over a photo. Outline is
    the whole affordance on a control at rest, so it clears 3:1 against every surface it touches.
    Both hover fills are light enough for one dark ink, so the text over them needs no theme binding.
  -->
  <Color x:Key="ControlFill">#1A1E4437</Color>
  <Color x:Key="ControlFillDark">#AF10161F</Color>
  <Color x:Key="ControlFillHover">#E0D6E4DC</Color>
  <Color x:Key="ControlFillHoverDark">#AAEEEEEE</Color>
  <Color x:Key="FieldFill">#99FFFFFF</Color>
  <Color x:Key="FieldFillDark">#33FFFFFF</Color>
  <Color x:Key="Outline">#991E4437</Color>
  <Color x:Key="OutlineDark">#77E6E2D9</Color>
  <Color x:Key="PhotoOverlayFill">#33999999</Color>

  <Color x:Key="White">White</Color>
  <Color x:Key="Black">Black</Color>
  <Color x:Key="MidnightBlue">#23211D</Color>
  <Color x:Key="OffBlack">#1D1C1A</Color>

  <Color x:Key="Gray100">#F1EEE7</Color>
  <Color x:Key="Gray200">#D5D0C3</Color>
  <Color x:Key="Gray300">#BEB8A9</Color>
  <Color x:Key="Gray400">#8A8577</Color>
  <Color x:Key="Gray500">#6B6659</Color>
  <Color x:Key="Gray600">#4C483F</Color>
  <Color x:Key="Gray900">#2B2925</Color>
  <Color x:Key="Gray950">#141311</Color>

  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
  <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
  <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
  <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
  <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />

  <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
  <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
  <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
  <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
  <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
  <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
  <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
  <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />
</ResourceDictionary>
