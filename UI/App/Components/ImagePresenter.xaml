<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="GT4.UI.Components.ImagePresenter"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">
  <Grid
      ColumnDefinitions="*"
      RowDefinitions="*">
    <Grid.GestureRecognizers>
      <TapGestureRecognizer Command="{Binding OpenViewerCommand, Source={x:Reference Root}}" />
    </Grid.GestureRecognizers>
    <!--  Aspect comes from the caller's style: a local value here would silently outrank it.  -->
    <Image
        x:Name="Picture"
        Opacity="{Binding ImageOpacity1, Source={x:Reference Root}}"
        Source="{Binding Image1, Source={x:Reference Root}}"
        Style="{Binding ImageStyle, Source={x:Reference Root}, TargetNullValue={StaticResource PhotoThumbStyle}}" />
    <Image
        Opacity="{Binding ImageOpacity2, Source={x:Reference Root}}"
        Source="{Binding Image2, Source={x:Reference Root}}"
        Style="{Binding ImageStyle, Source={x:Reference Root}, TargetNullValue={StaticResource PhotoThumbStyle}}" />
    <ImageButton
        BackgroundColor="Transparent"
        Command="{Binding Command, Source={x:Reference Root}}"
        CommandParameter="PrevPicture"
        HorizontalOptions="Start"
        IsVisible="{Binding ShowPrevNext, Source={x:Reference Root}}"
        Opacity="0.2"
        Source="left_row.png"
        VerticalOptions="Center" />
    <ImageButton
        BackgroundColor="Transparent"
        Command="{Binding Command, Source={x:Reference Root}}"
        CommandParameter="NextPicture"
        HorizontalOptions="End"
        IsVisible="{Binding ShowPrevNext, Source={x:Reference Root}}"
        Opacity="0.2"
        Source="right_row.png"
        VerticalOptions="Center" />
    <!--
      Capped against the picture: every host sizes this column by what is in it, so an uncapped
      caption, which is a whole attribution line, measures wider than the photo and stretches the
      pane to the text.
    -->
    <Label
        BackgroundColor="#80000000"
        HorizontalOptions="Fill"
        HorizontalTextAlignment="Center"
        InputTransparent="True"
        IsVisible="{Binding ShowCurrentCaption, Source={x:Reference Root}}"
        LineBreakMode="WordWrap"
        MaximumWidthRequest="{Binding Width, Source={x:Reference Picture}}"
        Padding="6,3"
        Text="{Binding CurrentCaption, Source={x:Reference Root}}"
        TextColor="White"
        VerticalOptions="End" />
  </Grid>
</ContentView>
