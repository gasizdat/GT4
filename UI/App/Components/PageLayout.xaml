<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="GT4.UI.Components.PageLayout"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:items="clr-namespace:GT4.UI.Items"
    x:Name="Root">

  <ContentView.Resources>
    <ResourceDictionary>
      <Thickness
          x:Key="HeaderPadding"
          Bottom="0"
          Left="{StaticResource PageContentHorizontalPadding}"
          Right="{StaticResource PageContentHorizontalPadding}"
          Top="0" />

      <Thickness
          x:Key="BodyPadding"
          Bottom="{StaticResource PageContentVerticalPadding}"
          Left="{StaticResource PageContentHorizontalPadding}"
          Right="{StaticResource PageContentHorizontalPadding}"
          Top="{StaticResource PageContentVerticalPadding}" />

      <Thickness
          x:Key="FooterPadding"
          Bottom="{StaticResource PageContentVerticalPadding}"
          Left="{StaticResource PageContentHorizontalPadding}"
          Right="{StaticResource PageContentHorizontalPadding}"
          Top="0" />

      <Style x:Key="MenuButton" BasedOn="{StaticResource EmojiAdorner}" TargetType="Button">
        <Setter Property="CommandParameter" Value="{Binding CommandParameter}" />
        <Setter Property="Command" Value="{Binding Command}" />
        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
        <Setter Property="Text" Value="{Binding ButtonText}" />
        <Setter Property="ToolTipProperties.Text" Value="{Binding ToolTipText}" />
      </Style>

      <DataTemplate
          x:Key="MenuItemTemplate"
          x:DataType="items:PageMenuItem">
        <Button
            FontSize="{DynamicResource ActionButtonTextSize}"
            HeightRequest="{DynamicResource MenuButtonSize}"
            HorizontalOptions="Center"
            Style="{StaticResource MenuButton}"
            WidthRequest="{DynamicResource MenuButtonSize}" />
      </DataTemplate>
    </ResourceDictionary>
  </ContentView.Resources>

  <!--  Single-column on purpose: MAUI sizes a star row to the whole grid, not to what its Auto rows
        leave, as soon as a child spans columns, which pushes the footer off the page.  -->
  <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">
    <Image
        Grid.RowSpan="5"
        Aspect="AspectFill"
        IsAnimationPlaying="{Binding Animation.IsEnabled, Source={x:Reference Root}}"
        Opacity="0.3"
        Source="tree_bg.gif" />

    <!--  Back and title  -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
      <Button
          Margin="{Thickness Left={StaticResource PageContentHorizontalPadding}}"
          BindingContext="{Binding BackItem, Source={x:Reference Root}}"
          IsVisible="{Binding IsBackButtonVisible, Source={x:Reference Root}}"
          Style="{StaticResource MenuButton}"
          VerticalOptions="Center" />

      <Label
          Grid.Column="1"
          Margin="{Thickness Left={StaticResource PageContentHorizontalPadding},
                             Right={StaticResource PageContentHorizontalPadding}}"
          IsVisible="{Binding IsTitleVisible, Source={x:Reference Root}}"
          Style="{StaticResource PageTitle}"
          Text="{Binding Title, Source={x:Reference Root}}" />
    </Grid>

    <!--  Hint  -->
    <Label
        Grid.Row="1"
        Margin="{Thickness Left={StaticResource PageContentHorizontalPadding},
                           Right={StaticResource PageContentHorizontalPadding}}"
        IsVisible="{Binding IsHintVisible, Source={x:Reference Root}}"
        Style="{StaticResource PageSubtitle}"
        Text="{Binding Hint, Source={x:Reference Root}}" />

    <!--  Header slot  -->
    <Grid
        Grid.Row="2"
        Padding="{StaticResource HeaderPadding}"
        RowDefinitions="*, Auto">

      <FlexLayout
          x:Name="TopMenu"
          BindableLayout.ItemTemplate="{StaticResource MenuItemTemplate}"
          BindableLayout.ItemsSource="{Binding MenuItems, Source={x:Reference Root}}"
          Direction="Row"
          HorizontalOptions="End"
          IsVisible="{Binding IsTopMenuVisible, Source={x:Reference Root}}"
          Wrap="Wrap" />

      <ContentView
          Grid.Row="1"
          Content="{Binding Header, Source={x:Reference Root}}"
          IsVisible="{Binding IsHeaderVisible, Source={x:Reference Root}}" />
    </Grid>

    <!--  Body slot  -->
    <Grid
        x:Name="BodySlot"
        Grid.Row="3"
        Padding="{StaticResource BodyPadding}"
        ColumnDefinitions="*, Auto">

      <ContentView Content="{Binding Body, Source={x:Reference Root}}" />

      <FlexLayout
          x:Name="SideMenu"
          Grid.Column="1"
          BindableLayout.ItemTemplate="{StaticResource MenuItemTemplate}"
          BindableLayout.ItemsSource="{Binding MenuItems, Source={x:Reference Root}}"
          Direction="Column"
          HorizontalOptions="End"
          IsVisible="{Binding IsSideMenuVisible, Source={x:Reference Root}}"
          Wrap="Wrap" />

    </Grid>

    <ActivityIndicator
        x:Name="LoadingIndicator"
        Grid.Row="3"
        HorizontalOptions="Center"
        InputTransparent="True"
        IsRunning="{Binding Loading.IsLoading, Source={x:Reference Root}, FallbackValue=False}"
        IsVisible="{Binding Loading.IsLoading, Source={x:Reference Root}, FallbackValue=False}"
        VerticalOptions="Center" />

    <!--  Footer slot  -->
    <ContentView
        x:Name="FooterSlot"
        Grid.Row="4"
        Padding="{StaticResource FooterPadding}"
        Content="{Binding Footer, Source={x:Reference Root}}"
        IsVisible="{Binding IsFooterVisible, Source={x:Reference Root}}" />
  </Grid>

</ContentView>
