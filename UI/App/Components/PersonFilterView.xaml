<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="GT4.UI.Components.PersonFilterView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:GT4.UI.Behaviors"
    xmlns:resources="clr-namespace:GT4.UI.Resources;assembly=GT4.UI.Resources"
    x:Name="Root">

  <!--  The names are used only for the Device Tests purposes.  -->

  <Grid
      HorizontalOptions="Fill"
      RowDefinitions="Auto, Auto">

    <!--  Row 0 - Active filters summary and the clear button  -->
    <Grid
        Grid.Row="0"
        ColumnDefinitions="*, Auto">

      <Label
          Grid.Column="0"
          LineBreakMode="TailTruncation"
          Style="{StaticResource FieldValue}"
          Text="{Binding CurrentFilterSet, Source={x:Reference Root}}"
          VerticalOptions="Center">
        <Label.Behaviors>
          <behaviors:FadeVisibilityBehavior
              IsVisible="{Binding IsAnyFilterActive, Source={x:Reference Root}}"
              Duration="500" />
        </Label.Behaviors>
      </Label>

      <Button
          x:Name="ClearFiltersButton"
          Grid.Column="1"
          Command="{Binding FilterCommand, Source={x:Reference Root}}"
          CommandParameter="ClearFiltersCommand"
          HorizontalOptions="End"
          Style="{StaticResource ClearAdorner}"
          ToolTipProperties.Text="{x:Static resources:UIStrings.BtnNameClearFilters}"
          VerticalOptions="Center">
        <Button.Behaviors>
          <behaviors:FadeVisibilityBehavior
              IsVisible="{Binding IsAnyFilterActive, Source={x:Reference Root}}"
              Duration="500" />
        </Button.Behaviors>
      </Button>
    </Grid>

    <!--
      Row 1 - Filter fields. Fades via FadeVisibilityBehavior instead of snapping like a plain
      IsVisible binding would.
    -->
    <Grid
        x:Name="FiltersPanel"
        Grid.Row="1"
        ColumnDefinitions="Auto, Auto, *"
        HorizontalOptions="Fill"
        RowDefinitions="Auto, Auto, Auto, Auto">

      <Grid.Behaviors>
        <behaviors:FadeVisibilityBehavior
            IsVisible="{Binding IsFiltersVisible, Source={x:Reference Root}}"
            Duration="500" />
      </Grid.Behaviors>

      <!--  Row 0 - Name search  -->
      <Label
          Grid.Row="0"
          Grid.Column="0"
          Style="{StaticResource FieldName}"
          Text="{x:Static resources:UIStrings.FieldSearchText}" />

      <Entry
          x:Name="NameFilterEntry"
          Grid.Row="0"
          Grid.Column="1"
          Grid.ColumnSpan="2"
          HorizontalOptions="Fill"
          Placeholder="{x:Static resources:UIStrings.HintNameFilterWildcard}"
          Style="{StaticResource FieldValue}"
          Text="{Binding NameFilter, Source={x:Reference Root}}" />

      <!--  Row 1 - Sex / marital status  -->
      <Label
          Grid.Row="1"
          Grid.Column="0"
          Style="{StaticResource FieldName}"
          Text="{x:Static resources:UIStrings.FieldFilterSex}" />

      <Picker
          x:Name="SexFilterPicker"
          Grid.Row="1"
          Grid.Column="1"
          ItemsSource="{Binding SexFilterLabels, Source={x:Reference Root}}"
          SelectedIndex="{Binding SexFilterIndex, Source={x:Reference Root}}"
          Style="{StaticResource FieldValue}" />

      <Picker
          x:Name="MaritalStatusFilterPicker"
          Grid.Row="1"
          Grid.Column="2"
          ItemsSource="{Binding MaritalStatusFilterLabels, Source={x:Reference Root}}"
          SelectedIndex="{Binding MaritalStatusFilterIndex, Source={x:Reference Root}}"
          Style="{StaticResource FieldValue}" />

      <!--  Row 2 - Year filter toggle  -->
      <Label
          Grid.Row="2"
          Grid.Column="0"
          Style="{StaticResource FieldName}"
          Text="{x:Static resources:UIStrings.FieldYear}" />

      <Switch
          x:Name="YearFilterSwitch"
          Grid.Row="2"
          Grid.Column="1"
          IsToggled="{Binding IsYearFilterEnabled, Source={x:Reference Root}}" />

      <Label
          Grid.Row="2"
          Grid.Column="2"
          HorizontalOptions="End"
          Style="{StaticResource FieldValue}"
          Text="{Binding SelectedYearText, Source={x:Reference Root}}" />

      <!--  Row 3 - Year slider. Maximum precedes Minimum so the range never inverts mid-update.  -->
      <Slider
          x:Name="YearSlider"
          Grid.Row="3"
          Grid.ColumnSpan="3"
          IsEnabled="{Binding IsYearFilterEnabled, Source={x:Reference Root}}"
          Maximum="{Binding MaxYear, Source={x:Reference Root}}"
          Minimum="{Binding MinYear, Source={x:Reference Root}}"
          Value="{Binding SelectedYear, Source={x:Reference Root}}" />
    </Grid>
  </Grid>
</ContentView>
