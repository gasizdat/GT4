<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="GT4.UI.Components.CalendarDateView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:resources="clr-namespace:GT4.UI.Resources;assembly=GT4.UI.Resources">

  <ContentView.ControlTemplate>
    <ControlTemplate>
      <Grid
          ColumnDefinitions="*, 2*, Auto"
          ColumnSpacing="{StaticResource PageContentSpacing}"
          RowDefinitions="Auto, Auto"
          RowSpacing="{StaticResource PageContentSpacing}">

        <Picker
            Grid.Row="0"
            Grid.ColumnSpan="3"
            HorizontalOptions="Fill"
            ItemsSource="{Binding CalendarNames, Source={RelativeSource TemplatedParent}}"
            SelectedIndex="{Binding CalendarIndex, Source={RelativeSource TemplatedParent}}" />

        <Entry
            Grid.Row="1"
            Grid.Column="0"
            HorizontalOptions="Fill"
            Keyboard="Numeric"
            Placeholder="{x:Static resources:UIStrings.FieldYear}"
            Text="{Binding Year, Source={RelativeSource TemplatedParent}}" />

        <Picker
            Grid.Row="1"
            Grid.Column="1"
            HorizontalOptions="Fill"
            ItemsSource="{Binding Months, Source={RelativeSource TemplatedParent}}"
            SelectedIndex="{Binding MonthIndex, Source={RelativeSource TemplatedParent}}" />

        <Picker
            Grid.Row="1"
            Grid.Column="2"
            ItemsSource="{Binding Days, Source={RelativeSource TemplatedParent}}"
            SelectedIndex="{Binding DayIndex, Source={RelativeSource TemplatedParent}}" />

      </Grid>
    </ControlTemplate>
  </ContentView.ControlTemplate>
</ContentView>
