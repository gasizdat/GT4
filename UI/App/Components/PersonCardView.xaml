<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="GT4.UI.Components.PersonCardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:GT4.UI.Components"
    x:Name="Root"
    InputTransparent="True"
    IsVisible="False">

  <Border
      Padding="12,6"
      BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle},
                                        Dark={StaticResource SurfaceSubtleDark}}"
      StrokeShape="RoundRectangle 8"
      StrokeThickness="0">
    <components:PersonInfoView
        NameFormat="FullPersonName"
        Person="{Binding Person, Source={x:Reference Root}}" />
  </Border>

</ContentView>
