<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="GT4.UI.Components.TabItemView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

  <Border
      x:Name="Chrome"
      Padding="12,6"
      MinimumHeightRequest="44"
      StrokeShape="RoundRectangle 14"
      StrokeThickness="1.5"
      VerticalOptions="Center">
    <Border.GestureRecognizers>
      <TapGestureRecognizer
          Command="{Binding Command, Source={x:Reference Root}}"
          CommandParameter="{Binding CommandParameter, Source={x:Reference Root}}" />
      <PointerGestureRecognizer
          PointerEntered="OnPointerEntered"
          PointerExited="OnPointerExited" />
    </Border.GestureRecognizers>

    <!--  A VisualState on the Border cannot reach this Label, so the ladder has to suit one colour.  -->
    <Label
        FontSize="{DynamicResource LabelTextSizeDefault}"
        Text="{Binding Text, Source={x:Reference Root}}"
        TextColor="{AppThemeBinding Light={StaticResource MidnightBlue},
                                    Dark={StaticResource White}}"
        VerticalTextAlignment="Center" />

    <!--
      A Border rather than a Button: a DataTrigger on a native Button's colours does not repaint on
      WinUI, which is the one thing a tab strip needs. The three states then have to share a single
      group, because a selection trigger and the platform's own PointerOver would both write
      BackgroundColor, and whichever restored last would win the click - always made while hovering.
    -->
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroupList>
        <VisualStateGroup x:Name="TabStates">
          <VisualState x:Name="Inactive">
            <VisualState.Setters>
              <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ControlFill}, Dark={StaticResource ControlFillDark}}" />
              <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Hovered">
            <VisualState.Setters>
              <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FieldFill}, Dark={StaticResource SurfaceSubtleDark}}" />
              <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Active">
            <VisualState.Setters>
              <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray600}}" />
              <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gray100}}" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateGroupList>
    </VisualStateManager.VisualStateGroups>
  </Border>

</ContentView>
