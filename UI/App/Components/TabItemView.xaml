<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="GT4.UI.Components.TabItemView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

  <!--
    A Border rather than a Button: a DataTrigger on a native Button's colours does not repaint on
    WinUI, which is the one thing a tab strip needs.
  -->
  <Border
      Padding="12,6"
      BackgroundColor="{AppThemeBinding Light={StaticResource ControlFill},
                                        Dark={StaticResource ControlFillDark}}"
      MinimumHeightRequest="44"
      Stroke="{AppThemeBinding Light={StaticResource Outline},
                               Dark={StaticResource OutlineDark}}"
      StrokeShape="RoundRectangle 14"
      StrokeThickness="1.5"
      VerticalOptions="Center">
    <Border.GestureRecognizers>
      <TapGestureRecognizer
          Command="{Binding Command, Source={x:Reference Root}}"
          CommandParameter="{Binding CommandParameter, Source={x:Reference Root}}" />
    </Border.GestureRecognizers>

    <Border.Triggers>
      <DataTrigger
          Binding="{Binding IsActive, Source={x:Reference Root}}"
          TargetType="Border"
          Value="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ControlFillHover}, Dark={StaticResource ControlFillHoverDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gray100}}" />
      </DataTrigger>
    </Border.Triggers>

    <!--  Neither a Border setter nor a VisualState on it reaches this Label, so the ink repeats the binding.  -->
    <Label
        FontSize="{DynamicResource LabelTextSizeDefault}"
        Text="{Binding Text, Source={x:Reference Root}}"
        TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource Gray100}}"
        VerticalTextAlignment="Center">
      <Label.Triggers>
        <DataTrigger
            Binding="{Binding IsActive, Source={x:Reference Root}}"
            TargetType="Label"
            Value="True">
          <Setter Property="TextColor" Value="{StaticResource PrimaryDarkText}" />
        </DataTrigger>
      </Label.Triggers>
    </Label>

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroupList>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ControlFillHover}, Dark={StaticResource ControlFillHoverDark}}" />
              <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gray100}}" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateGroupList>
    </VisualStateManager.VisualStateGroups>
  </Border>

</ContentView>
