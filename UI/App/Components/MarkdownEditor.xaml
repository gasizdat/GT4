<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="GT4.UI.Components.MarkdownEditor"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:GT4.UI.Components"
    xmlns:resources="clr-namespace:GT4.UI.Resources;assembly=GT4.UI.Resources"
    x:Name="Root">

  <AbsoluteLayout>
    <VerticalStackLayout
        AbsoluteLayout.LayoutBounds="0,0,1,AutoSize"
        AbsoluteLayout.LayoutFlags="WidthProportional">

      <!--  Reserves the floating header's own height so the content starts below it at rest  -->
      <BoxView
          HeightRequest="{Binding Source={x:Reference Header}, Path=Height}"
          InputTransparent="True"
          Opacity="0" />

      <!--  Content  -->
      <Grid>
        <Editor
            x:Name="TextEditor"
            AutoSize="TextChanges"
            HorizontalOptions="Fill"
            IsVisible="{Binding DisplayEditor, Source={x:Reference Root}}"
            Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
            Text="{Binding Markdown, Source={x:Reference Root}}"
            VerticalOptions="Fill" />

        <components:MarkdownView
            HorizontalOptions="Fill"
            IsVisible="{Binding DisplayPreview, Source={x:Reference Root}}"
            Markdown="{Binding Markdown, Source={x:Reference Root}}"
            MediaResolver="{Binding MediaResolver, Source={x:Reference Root}}"
            VerticalOptions="Fill" />
      </Grid>
    </VerticalStackLayout>

    <!--
      Header, floated over the content: the code-behind pins its TranslationY so it never scrolls
      above the ancestor ScrollView's own visible top, nor below its resting position at the top
      of the editor (#446).
    -->
    <HorizontalStackLayout
        x:Name="Header"
        AbsoluteLayout.LayoutBounds="0,0,1,AutoSize"
        AbsoluteLayout.LayoutFlags="WidthProportional"
        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource OffBlack}}"
        Margin="{Thickness Bottom={StaticResource PageContentSpacing}}">
      <components:TabItemView
          Margin="{Thickness Right={StaticResource PageContentSpacing}}"
          Command="{Binding Command, Source={x:Reference Root}}"
          CommandParameter="Tab0"
          IsActive="{Binding DisplayEditor, Source={x:Reference Root}}"
          Text="{x:Static resources:UIStrings.BtnNameMarkdownEditor}" />

      <components:TabItemView
          Margin="{Thickness Right={StaticResource PageContentSpacing}}"
          Command="{Binding Command, Source={x:Reference Root}}"
          CommandParameter="Tab1"
          IsActive="{Binding DisplayPreview, Source={x:Reference Root}}"
          Text="{x:Static resources:UIStrings.BtnNameMarkdownView}" />

      <Button
          Margin="{Thickness Right={StaticResource PageContentSpacing}}"
          Command="{Binding InsertLinkCommand, Source={x:Reference Root}}"
          CommandParameter="InsertPersonLinkCommand"
          IsVisible="{Binding DisplayEditor, Source={x:Reference Root}}"
          Text="{x:Static resources:UIStrings.BtnNameInsertPersonLink}" />
      <Button
          Command="{Binding InsertLinkCommand, Source={x:Reference Root}}"
          CommandParameter="InsertMediaLinkCommand"
          IsVisible="{Binding DisplayEditor, Source={x:Reference Root}}"
          Text="{x:Static resources:UIStrings.BtnNameInsertMediaLink}" />
    </HorizontalStackLayout>
  </AbsoluteLayout>
</ContentView>
