<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Pinned rather than taken from the installed workload: since 10.0.101 (dotnet/maui#39342),
         MAUI's Resizetizer throws MissingMethodException rasterizing the SVG text and drop-shadow
         filter in our app icon and splash, and CI's runner image picks such versions up unannounced. -->
    <MauiVersion>10.0.20</MauiVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="AutoFixture" Version="4.18.1" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="DeviceRunners.Testing.Targets" Version="0.1.0-preview.12" />
    <PackageVersion Include="DeviceRunners.UITesting.Maui" Version="0.1.0-preview.12" />
    <PackageVersion Include="DeviceRunners.UITesting.Xunit3" Version="0.1.0-preview.12" />
    <PackageVersion Include="DeviceRunners.VisualRunners.Maui" Version="0.1.0-preview.12" />
    <PackageVersion Include="DeviceRunners.VisualRunners.Xunit3" Version="0.1.0-preview.12" />
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageVersion Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <!-- GT4.Tools.ModelExport only: a dev-time checkpoint-to-ONNX converter for #506's restore
         models, never shipped in the app. -->
    <PackageVersion Include="Onnxify" Version="0.3.11" />
    <PackageVersion Include="Onnxify.TorchSharp" Version="0.3.11" />
    <PackageVersion Include="SkiaSharp" Version="4.152.0" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="TorchSharp" Version="0.107.0" />
    <PackageVersion Include="TorchSharp-cpu" Version="0.107.0" />
    <PackageVersion Include="TorchSharp.PyBridge" Version="1.4.4" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.v3.assert" Version="3.2.2" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="3.2.2" />
  </ItemGroup>

</Project>
